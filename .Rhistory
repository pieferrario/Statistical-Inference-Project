#Parte prima (meno interessante) #ispirata al formulario del Prof. Aldo Clemente
#allestimento:
#getwd(): restituisce il percorso per la cartella di lavoro
#setwd("percorso/directory"): imposta il percorso per la cartella di lavoro
#ls(): mostra il contenuto della cartella di lavoro
#rm(list=ls()): ripulisce completamente l’area di lavoro ("workspace")
#rm(variabile.V): rimuove la variabile variabile.V
##commento.C: inserisce il commento commento.C (Ctrl Shift C)
#install.packages("pacchetto.P"): scarica il pacchetto denominato pacchetto.P
#library(pacchetto.P): carica il pacchetto denominato pacchetto.P nell’ambiente di lavoro
#?comando.C/help(comando.C): apre la documentazione relativa al comando comando.C nell’Help di R
#gestione dei dataframe:
#dataframe.D=read.table("dataset.txt",header=TRUE): legge il documento denominato dataset.txt (considerando l’intestazione) e lo salva nella variabile dataframe.D come dataframe
#dataframe.D=read.csv("dataset.csv",header=TRUE): legge il documento denominato dataset.csv (considerando l’intestazione) e lo salva nella variabile dataframe.D come dataframe
#write.table(dataframe.D,"dataset.txt"): crea un documento di testo denominato dataset.txt contenente il dataframe dataframe.D nella cartella di lavoro
#data("USArrests"): carica il dataset USArrest (disponibile in R)
#dataframe.D$variabile.V: restituisce la colonna denominata variabile.V del dataset dataframe.D
#attach(dataframe.D): consente di accedere direttamente alle variabili (colonne) contenute nel dataframe dataframe.D (tramite nome.variabile invece di dataframe.D$nome.variabile)
#detach(dataframe.D): impedisce l’accesso diretto alle variabili (colonne) contenute nel dataframe dataframe.D
#colnames(dataframe.D)/names(dataframe.D): restituisce il nome delle variabili (colonne) contenute in dataframe.D
#head(dataframe.D,n): restituisce le prime n osservazioni nel dataframe dataframe.D
#tail(dataframe.D,n): restituisce le ultime n osservazioni nel dataframe dataframe.D
#nrow(dataframe.D): restituisce il numero di righe del dataframe dataframe.D
#ncol(dataframe.Dv): restituisce il numero di colonne del dataframe dataframe.D
#dim(dataframe.D): restituisce la dimensione (numero di righe, numero di colonne) del dataframe dataframe.D
#apply(vettore.V,margin,funzione.F): applica la funzione funzione.F a ciascun sottoinsieme di vettore.V individuato da margin
#summary(x): mostra gli indicatori fondamentali dell’oggetto x
#vettori:
#c(1,2,3): crea vettore con elementi 1, 2, 3
#c(x,y): concatenza vettori o elementi x ed y
#vettore.V[i]: restituisce l’elemento i-esimo del vettore vettore.V
#which(vettore.V=="c"): seleziona gli indici di posizione degli elementi del vettore vettore.V uguali a c
#rep(elemento.E,n): costruisce un vettore formato dall’elemento elemento.E n ripetuto n volte
#seq(minimo.m,massimo.M,by=passo.P): costruisce un vettore di elementi equispaziati da minimo.m a massimo.M con passo passo.P
#seq(minimo.m,massimo.M,length=lunghezza.L): costruisce un vettore di lunghezza.L elementi equispaziati da minimo.m a massimo.M
#is.na(vettore.V): restituisce un vettore con valori TRUE in corrispondenza di NA contenuti nel vettore vettore.V e FALSE per il resto degli elementi
#length(vettore.V): restituisce il numero di elementi contenuti nel vettore vettore.V
#unique(vettore.V): estrae i valori distinti del vettore vettore.V
#sort(vettore.V,decreasing=FALSE): ordina il vettore vettore.V in ordine ascendente
#sum(vettore.V): calcola la somma di tutti gli elementi del vettore vettore.V
#prod(vettore.V): calcola il prodotto tra tutti gli elementi del  vettore vettore.V
#variabile.categorica.VC=as.factor(vettore.V): trasforma il vettore vettore.V nella variabile categorica variabile.categorica.VC
#levels(variabile.categorica.VC): mostra i livelli presenti all’interno della variabile categorica variabile.categorica.VC
#matrici:
#matrix(vettore.V,nrow=numero.di.righe,ncol=numero.di.colonne,byrow=FALSE): costruisce una matrice numero.di.righe x numero.di.colonne riempendola per colonne con i valori contenuti nel vettore vettore.V
#matrice.M[i,]: restituisce gli elementi della riga i-esima della matrice matrice.M
#matrice.M[,i]: restituisce gli elementi della colonna i-esima della matrice matrice.M
#cbind(vettore.V,vettore.W,vettore.X): costruisce una matrice avente come colonne i vettori vettore.V, vettore.W, vettore.X
#rbind(vettore.V,vettore.W,vettore.X): costruisce una matrice avente come righe i vettori vettore.V, vettore.W, vettore.X
#table(matrice.M): calcola le frequenze assolute dei dati in matrice.M
#prop.table(matrice.M): calcola le frequenze relative dei dati in matrice.M
#colSums(matrice.M): calcola la somma degli elementi contenuti in ciascuna colonna di matrice.M
#rowSums(matrice.M): calcola la somma degli elementi contenuti in ciascuna riga di matrice.M
#tapply(matrice.M,index,funzione.F): divide i dati in matrice.M in sottogruppi ottenuti sulla base dei valori in index e applica la funzione funzione.F a ciascun sottogruppo
#operazioni matematiche:
#abs(vettore.V): calcola il valore assoluto degli elementi nel vettore vettore.V
#sqrt(vettore.V), cos(vettore.V), sin(vettore.V), log(vettore.V,base=base.B), log(vettore.V), exp(vettore.V): calcola la radice quadrata, il coseno, il seno, il logaritmo in base base.B, il logaritmo naturale e l’esponenziale degli elementi nel vettore vettore.V
#round(vettore.V,digits=n): approssima gli elementi del vettore vettore.V alla n-esima cifra decimale
#ceiling(vettore.V): approssima gli elementi del vettore vettore.V con l’intero successivo
#floor(vettore.V): approssima gli elementi del vettore vettore.V con l’intero precedente
#indici statistici:
#mean(vettore.V): calcola la media dei dati in vettore.V
#median(vettore.V): calcola la mediana dei dati in vettore.V
#min(vettore.V): calcola il minimo dei dati in vettore.V
#max(vettore.V): calcola il massimo dei dati in vettore.V
#IQR(vettore.V,type=2): calcola lo scarto interquartile di vettore.V
#quantile(vettore.V,probs=alfa,type=2): calcola il quantile di ordine alfa dei dati in vettore.V
#range(vettore.V): restituisce il minimo valore e il massimo valore contenuti in vettore.V
#sd(vettore.V): calcola la deviazione standard dei dati in vettore.V
#var(vettore.V): calcola la varianza campionaria dei dati in vettore.V
#cov(vettore.V,vettore.W): calcola la covarianza campionaria di vettore.V e vettore.W
#cor(vettore.V,vettore.W): calcola il coefficiente campionario di correlazione lineare di vettore.V e vettore.W
#shapiro.test(vettore.V): calcola un test di Shapiro di #normalita' sulla base dei dati nel vettore vettore.V
#grafici:
#graphics.off(): chiude le finestre grafiche aperte
#plot.new(): apre una nuova finestra grafica interna al programma
#x11(), quartz(), dev.new(): apre e attiva una nuova finestra grafica in previsione di eseguire i comandi per la creazione di un grafico
#barplot(table(variabile.categorica.VC)): costruisce il diagramma a barre dei dati nel vettore variabile.categorica.VC (frequenze assolute)
#pie(table(variabile.categorica.VC)): costruisce il diagramma a torta dei dati nel vettore variabile.categorica.VC (frequenze assolute)
#plot(vettore.V,vettore.W,...): rappresenta i punti di coordinate contenute nei vettori vettore.V e vettore.W
#boxplot(vettore.V,...): costruisce il boxplot del vettore vettore.V
#hist(vettore.V,...): costruisce l’istogramma del vettore vettore.V
#abline(h=valore,...): costruisce una retta orizzontale nel grafico aperto in corrispondenza di y=valore
#abline(v=valore,...): costruisce una retta verticale nel grafico aperto in corrispondenza di x=valore
#abline(a=intercetta,b=coefficiente.direzionale): rappresenta la retta di equazione y=a+b*x nel grafico aperto
#curve(funzione.F(minimo.M,massimo.M),add=TRUE,...): aggiunge la funzione funzione.F(x) nel grafico aperto tra x=minimo.m e x=massimo.m
#legend(posizione.P,nome.V,...): aggiunge la legenda al grafico aperto specificandone la posizione con posizione.P e il contenuto con nome.V
#rug(vettore.V): aggiunge i dati di vettore.V (lineette in corrispondenza dei dati) al grafico aperto
#polygon(c(vettore.V),c(vettore.W),...): aggiunge un poligono con i vertici individuati dalle coordinate di vettore.V e vettore.W al grafico aperto
#points(vettore.V,vettore.W,...): aggiunge i punti di coordinate contenute nei vettori vettore.V e vettore.W al grafico aperto
#text(vettore.V,vettore.W,testo.T,...): aggiunge il testo test.T nel grafico aperto nelle posizioni individuate dalle coordinate di vettore.V e vettore.W
#title(titolo.T,...): aggiunge il titolo titolo.T al grafico aperto
#xlim=c(minimo.m,massimo.M): specifica il limite inferiore minimo.m ed il limite superiore massimo.M per l’asse x
#ylim=c(minimo.m,massimo.M): specifica il limite inferiore minimo.m ed il limite superiore massimo.M per l’asse y
#metodi Monte Carlo:
#set.seed(numero): imposta il seme numero per il generatore di numeri pseudo-casuali
#rbinom(n, dimensione.N, p): simula n realizzazioni della variabile casuale binomiale di dimensione.N prove con probabilità di successo pari a p
#rpois(n, lambda): simula n realizzazioni della variabile casuale poissoniana con parametro lambda
#runif(n, min=m, max=M): simula n realizzazioni della variabile casuale uniforme tra m ed M
#rnorm(n, media.M, sd=sigma): simula n realizzazioni della variabile casuale normale di media M e deviazione standard sigma
#rgamma(n, shape=k, rate=theta): simula n realizzazioni della variabile casuale gamma con parametro di forma k e parametro di scala theta
#rexp(n, rate=lambda): simula n realizzazioni della variabile casuale esponenziale con parametro lambda
#test di ipotesi:
#t.test(campione.C, alternative="alternative", mu=mu0, conf.level=conf.level): esegue il test t di Student con livello di confidenza conf.level, con media nulla mu0 e ipotesi alternativa alternative sul campione campione.C
#var.test(campione.C, alternative="alternative", mu=mu0, conf.level=conf.level): esegue il test F di Snedecor con livello di confidenza conf.level, con varianza nulla mu0 e ipotesi alternativa alternative sul campione campione.C
#prop.test(frequenza.F, alternative="alternative", mu=mu0, conf.level=conf.level): esegue il test Z per le proporzioni con livello di confidenza conf.level, con proporzione nulla mu0 e ipotesi alternativa alternative sul campione campione.C
#chisq.test(frequenza.F, alternative="alternative", mu=mu0, conf.level=conf.level): esegue il test Chi quadro di Pearson con livello di confidenza conf.level, con proporzione nulla mu0 e ipotesi alternativa alternative sul campione campione.C
pnorm(1.65)
