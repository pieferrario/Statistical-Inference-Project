colori <- ifelse(h$mids > 18, "green", "red")
hist(voti2, breaks=30, col=colori, main="Appello 1", xlab="Valori",
prob=TRUE, xlim=c(0,30), ylim=c(0, 0.13))
# Istogramma Appello 2
h <- hist(voti1, breaks=30, plot=FALSE)
colori <- ifelse(h$mids > 18, "green", "red")
hist(voti1, breaks=30, col=colori, main="Appello 2", xlab="Valori",
prob=TRUE, xlim=c(0,30), ylim=c(0, 0.13))
