voti1=c(runif(18, 0, 6), runif(18, 7,17), rep(18, 3), rep(19,7), rep(20, 5), rep(21, 7), rep(22, 7), 23, rep(24, 3), rep(25, 2), 26, 28)
voti2=c(runif(23, 0, 6), runif(15, 7, 17), rep(18,3), rep(19, 2), rep(20, 4), rep(21, 4), rep(22, 2), rep(23, 2), rep(24, 4), rep(25, 1), rep(26, 2), 28, 29)
dev.new()
par(mfrow = c(1, 2))  # Imposta due grafici affiancati
